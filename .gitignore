# Vendored cross-platform pydantic-core wheels; regenerated via
# `make vendor-wheels` (see scripts/vendor_wheels.py).
vendor/
# Web bundle (src/web/) — checked-in source, generated artefacts ignored.
# Regenerated via `make build-web` (see Makefile).
src/web/node_modules/
src/web/dist/

# Playwright E2E (ADR-0031). The harness itself (playwright.config.ts,
# tests/e2e/{fixtures,specs}) is checked in; everything generated by
# a run is not.
node_modules/
tests/e2e/test-results/
tests/e2e/screenshots/
tests/e2e/playwright-report/
tests/e2e/junit-results.xml
