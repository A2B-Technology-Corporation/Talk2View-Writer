<?xml version="1.0" encoding="UTF-8"?>
<description xmlns="http://openoffice.org/extensions/description/2006"
             xmlns:d="http://openoffice.org/extensions/description/2006"
             xmlns:xlink="http://www.w3.org/1999/xlink"
             xmlns:l="http://libreoffice.org/extensions/description/2011">
    <identifier value="com.talk2view.writer"/>
    <version value="1.0.7"/>
    <!-- LibreOffice "Check for Updates" reads this feed. The URL always
         resolves to the newest non-prerelease release's update.xml (so
         alphas are never offered); release.yml generates that update.xml. -->
    <update-information>
        <src xlink:href="https://github.com/A2B-Technology-Corporation/Talk2View-Writer/releases/latest/download/update.xml"/>
    </update-information>
    <display-name>
        <name lang="en">Talk2View for Writer</name>
    </display-name>
    <extension-description>
        <src lang="en" xlink:href="description/description_en.txt"/>
    </extension-description>
    <publisher>
        <name lang="en" xlink:href="https://talk2view.com">A2B Technology Corporation Pty Ltd</name>
    </publisher>
    <registration>
        <simple-license accept-by="user">
            <license-text lang="en" xlink:href="registration/LICENSE"/>
        </simple-license>
    </registration>
    <dependencies>
        <l:LibreOffice-minimal-version d:name="LibreOffice 7.0" value="7.0"/>
    </dependencies>
</description>
