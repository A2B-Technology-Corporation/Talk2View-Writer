<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Sidebar"
                    oor:package="org.openoffice.Office.UI">

    <node oor:name="Content">

        <!-- Deck: container for our panel in the sidebar -->
        <node oor:name="DeckList">
            <node oor:name="com.talk2view.writer.Deck" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string">
                    <value xml:lang="en">Talk2View</value>
                </prop>
                <prop oor:name="Id" oor:type="xs:string">
                    <value>com.talk2view.writer.Deck</value>
                </prop>
                <prop oor:name="IconURL" oor:type="xs:string">
                    <value>private:graphicrepository/sw/res/sidebar-mode.png</value>
                </prop>
                <prop oor:name="ContextList">
                    <value oor:separator=";">
                        WriterDocument, any, visible ;
                        WriterGlobalDocument, any, visible ;
                    </value>
                </prop>
                <prop oor:name="OrderIndex" oor:type="xs:int">
                    <value>900</value>
                </prop>
            </node>
        </node>

        <!-- Panel: rendered inside the deck -->
        <node oor:name="PanelList">
            <node oor:name="com.talk2view.writer.ChatPanel" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string">
                    <value xml:lang="en">Chat</value>
                </prop>
                <prop oor:name="Id" oor:type="xs:string">
                    <value>com.talk2view.writer.ChatPanel</value>
                </prop>
                <prop oor:name="DeckId" oor:type="xs:string">
                    <value>com.talk2view.writer.Deck</value>
                </prop>
                <prop oor:name="DefaultMenuCommand" oor:type="xs:string">
                    <value>service:com.talk2view.writer.Talk2ViewJob?showPanel</value>
                </prop>
                <prop oor:name="ContextList">
                    <value oor:separator=";">
                        WriterDocument, any, visible ;
                        WriterGlobalDocument, any, visible ;
                    </value>
                </prop>
                <prop oor:name="OrderIndex" oor:type="xs:int">
                    <value>100</value>
                </prop>
                <prop oor:name="ImplementationURL" oor:type="xs:string">
                    <value>private:resource/toolpanel/com.talk2view.writer.ChatPanelFactory/Chat</value>
                </prop>
            </node>
        </node>

    </node>

</oor:component-data>
